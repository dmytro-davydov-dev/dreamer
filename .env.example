# Firebase Configuration
# Copy this file to .env and fill in your Firebase project details
# Get these values from Firebase Console > Project Settings

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Development Settings
# Set to "true" to use Firebase emulators (requires emulators to be running)
VITE_USE_FIREBASE_EMULATORS=false

# Default API key — allows new users to record 2 trial dreams without a personal key.
# Set this to a real, limited-quota key in your deployment environment.
VITE_DEFAULT_LLM_API_KEY=

# Observability
# PostHog: omit to disable analytics (all capture calls become no-ops)
VITE_POSTHOG_KEY=phc_...
# Sentry: omit to disable error monitoring
VITE_SENTRY_DSN=https://...@sentry.io/...
VITE_APP_VERSION=0.1.0
